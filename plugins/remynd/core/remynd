#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# remynd — read your own screen history from the terminal.
#
# The retrieval surface shared by every agent: the Claude Code /remynd skill
# calls it, the Codex adapter calls it, and you can call it yourself. Keeping
# one implementation is why the two agents can't drift apart.
#
# READ-ONLY. Opens ReMynd's database with mode=ro; never writes to it.
# ---------------------------------------------------------------------------
set -u

# Resolve through symlinks: the installer puts a `remynd` symlink on PATH in
# ~/.remynd-sync/bin, so dirname of $0 is bin/, not the core/ directory the
# library lives in.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _target="$(readlink "$_self")"
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(dirname "$_self")/$_target" ;;
  esac
done
_here="$(cd "$(dirname "$_self")" && pwd)"

. "$_here/remynd-digest.sh" 2>/dev/null || {
  echo "remynd: could not load its core from $_here" >&2
  echo "  Reinstall with: bash <(curl -fsSL https://remyndai.com/claude/install.sh)" >&2
  exit 1
}

die() { printf 'remynd: %s\n' "$*" >&2; exit 1; }

_profile() {
  local p
  p="$(remynd_find_profile)" || die "no ReMynd recordings found on this Mac.
Is ReMynd installed and has it recorded yet? (Set REMYND_PROFILE to override.)"
  printf '%s\n' "$p"
}

usage() {
  cat <<'USAGE'
remynd — your own screen history, on the command line

  remynd now                     what you are doing right now
  remynd recent [minutes]        digest of recent activity (default 30)
  remynd search <query> [n]      full-text search everything you've seen
  remynd day <YYYY-MM-DD>        reconstruct a day
  remynd apps [days]             where your time went (default 7)
  remynd text <from> [to]        verbatim screen text in a time range
  remynd status                  sync state, profile, freshness
  remynd refresh                 rebuild the cached digest now

Times are LOCAL. Everything is read-only.

Examples
  remynd search "stripe webhook"
  remynd day 2026-08-13
  remynd text "2026-08-13 23:30" "2026-08-13 23:45"
USAGE
}

cmd_now() {
  local db; db="$(remynd_db_path "$(_profile)")"
  local n; n="$(remynd_now "$db")"
  [ -n "$n" ] && echo "$n" || echo "(nothing recorded yet)"
}

cmd_recent() {
  local mins="${1:-30}" db redact
  db="$(remynd_db_path "$(_profile)")"
  redact="$(remynd_config_get redact_credentials 1)"
  remynd_digest_full "$db" "$mins" "$(remynd_config_get session_budget_tokens 8000)" "$redact"
}

# Full-text search over everything that has been on screen.
cmd_search() {
  [ $# -ge 1 ] || die "usage: remynd search <query> [limit]"
  local q="$1" limit="${2:-40}" db redact
  db="$(remynd_db_path "$(_profile)")"
  redact="$(remynd_config_get redact_credentials 1)"

  # FTS5 MATCH. Single quotes doubled for SQL; the query is passed as a
  # phrase-tolerant expression so multi-word searches behave as expected.
  local esc; esc="$(printf '%s' "$q" | /usr/bin/sed "s/'/''/g")"

  # Say how many matched, not just how many were shown. Returning the 40 most
  # recent of 3,071 hits without saying so reads as "that is all there is".
  local total
  total="$(remynd_sql_num "$db" "
    SELECT COUNT(*) FROM OCRTextSegment s
    JOIN OCRTextSegment_FTS f ON f.rowid = s.id
    WHERE OCRTextSegment_FTS MATCH '$esc';")"
  if [ -n "$total" ] && [ "$total" -gt "$limit" ]; then
    printf 'Showing the %s most recent of %s matches. Narrow the query, or raise the limit: remynd search "%s" %s

' \
      "$limit" "$total" "$q" "$((limit * 5))"
  fi

  remynd_sql "$db" "
    SELECT datetime(s.firstSeenAt,'localtime'), REPLACE(s.displayText, char(10), ' ')
    FROM OCRTextSegment s
    JOIN OCRTextSegment_FTS f ON f.rowid = s.id
    WHERE OCRTextSegment_FTS MATCH '$esc'
    ORDER BY s.firstSeenAt DESC
    LIMIT $limit;" |
  /usr/bin/awk -F"$REMYND_FS" -v doredact="$redact" '
'"$(_remynd_redact_awk)"'
    NF { t = $2; if (doredact == 1) t = redact(t); printf "%s  %s\n", $1, t }
    END { if (NR == 0) print "(no matches — try fewer or different words)" }'
}

cmd_day() {
  [ $# -ge 1 ] || die "usage: remynd day <YYYY-MM-DD>"
  local day="$1" db next
  db="$(remynd_db_path "$(_profile)")"
  next="$(/bin/date -j -v+1d -f '%Y-%m-%d' "$day" '+%Y-%m-%d' 2>/dev/null)" || die "bad date: $day"

  # The user means a LOCAL day; the database is in UTC. Convert both ends.
  local from_utc to_utc lo hi olo ohi redact
  from_utc="$(remynd_local_to_utc "$day 00:00:00")"  || die "bad date: $day"
  to_utc="$(remynd_local_to_utc "$next 00:00:00")"   || die "bad date: $day"
  lo="$(remynd_id_at_time "$db" FocusedWindow startedAt "$from_utc")"
  hi="$(remynd_id_at_time "$db" FocusedWindow startedAt "$to_utc")"
  redact="$(remynd_config_get redact_credentials 1)"

  echo "# $day ($(/bin/date -j -f '%Y-%m-%d' "$day" '+%A' 2>/dev/null))"
  echo

  local act; act="$(remynd_activity_rollup "$db" "$lo" "$hi" 14)"
  if [ -n "$act" ]; then
    echo "## What you worked on"
    echo "$act"
    echo
  else
    echo "_Nothing recorded on this day._"
    echo
    return 0
  fi

  local sites; sites="$(remynd_domains "$db" "$lo" "$hi" 12)"
  [ -n "$sites" ] && { echo "## Sites"; echo "$sites"; echo; }

  echo "## How the day ran"
  # Bucket by hour, not by title. Grouping on (app,title) with MIN(startedAt)
  # silently drops any hour in which the user stayed in windows first seen
  # earlier — the day then appears to have holes it doesn't have.
  remynd_sql "$db" "
    SELECT strftime('%H', datetime(startedAt,'localtime')) hr,
           applicationName, windowTitle,
           SUM(MAX(0, strftime('%s', COALESCE(endedAt, startedAt)) - strftime('%s', startedAt))) secs
    FROM FocusedWindow
    WHERE id >= $lo AND id < $hi AND windowTitle IS NOT NULL AND windowTitle != ''
    GROUP BY hr, applicationName, windowTitle
    ORDER BY hr ASC, secs DESC;" |
  /usr/bin/awk -F"$REMYND_FS" '
'"$(_remynd_title_awk)"'
    # hr must be forced to a string. "00" from a field is numeric-looking, and
    # an uninitialised `last` is numeric 0, so hr != last compares 0 != 0 and
    # the midnight header silently never prints — merging hour 00 into 09.
    { hr = "" $1
      t = norm_title($3)
      if (t == "") next
      if (hr != last) { if (last != "") printf "\n"; printf "  %s:00  ", hr; last = hr; n = 0; delete seen }
      # substr counts BYTES in BSD awk, so a fixed cut lands inside a multibyte
      # character — "tonyudotong — claude — 120x30" splits an em-dash. awk then
      # aborts the record with "illegal byte sequence" and echoes a truncated
      # copy to stderr. Invisible in a terminal, but the MCP merges stderr into
      # stdout, and one invalid byte made a whole day decode as nothing.
      # Words never split a character; count in words.
      nk = split(t, wk, " ")
      key = tolower(nk >= 4 ? wk[1] " " wk[2] " " wk[3] " " wk[4] : t)
      if (key in seen) next
      seen[key] = 1
      if (n < 4) {
        d = ""
        for (i = 1; i <= nk; i++) {
          if (i > 1 && length(d " " wk[i]) > 40) break
          d = (d == "" ? wk[i] : d " " wk[i])
        }
        printf "%s%s", (n ? "  |  " : ""), d; n++
      }
      else if (n == 4) { printf "  |  ..."; n++ }
    }
    END { if (last != "") printf "\n" }'

  # A day can be split across profiles. Launching the production app while the
  # dev build is recording hands the recorder over — one profile freezes, the
  # other picks up — and this command reads ONE profile. The result is a day
  # with an hours-long hole in it and no hint that the missing hours exist
  # somewhere else. That is how a Google Meet the user definitely attended can
  # be absent from "what did I do", which reads as ReMynd not recording.
  #
  # Only pays for itself when there IS a hole: no gap, no extra queries.
  # Only speak when there is something the user does not already know. Every
  # day has holes — lunch, sleep, a meeting away from the desk — and narrating
  # those is noise. The one worth saying out loud is a hole that ANOTHER
  # profile was recording through, because that hole looks identical to "you
  # did nothing" and is the opposite of it.
  local gaps this_db
  gaps="$(remynd_sql "$db" "
    SELECT DISTINCT CAST(strftime('%H', datetime(startedAt,'localtime')) AS INT)
    FROM FocusedWindow WHERE id >= $lo AND id < $hi ORDER BY 1;" |
    /usr/bin/awk '{ h = $1 + 0
                    # One line per gap: `read a b` consumes a single line, so
                    # printing the ends separately leaves the second empty.
                    if (prev != "" && h - prev > 1) print prev + 1, h
                    prev = h }')"
  this_db="$db"
  while read -r gap_lo gap_hi; do
    [ -n "${gap_lo:-}" ] && [ -n "${gap_hi:-}" ] || continue
    local from_gap to_gap
    from_gap="$(remynd_local_to_utc "$(printf '%s %02d:00:00' "$day" "$gap_lo")")" || continue
    to_gap="$(remynd_local_to_utc "$(printf '%s %02d:00:00' "$day" "$gap_hi")")"   || continue
    for other in "$HOME/Library/Application Support/Move37/"*/Recordings/app.db; do
      [ -f "$other" ] || continue
      [ "$other" = "$this_db" ] && continue
      local n
      n="$(remynd_sql_num "$other" "
        SELECT COUNT(*) FROM FocusedWindow
        WHERE startedAt >= '$from_gap' AND startedAt < '$to_gap';" 2>/dev/null)"
      if [ -n "$n" ] && [ "$n" -gt 20 ]; then
        printf '\nNothing is recorded here between %02d:00 and %02d:00, but another ReMynd\n' "$gap_lo" "$gap_hi"
        printf 'profile was holding the recorder then — %s.\n' "$(basename "$(dirname "$(dirname "$other")")")"
        printf 'Those hours happened; this day is partial, not quiet.\n'
        break
      fi
    done
  done <<EOS
$gaps
EOS

  echo
  echo "Verbatim screen text for any stretch:  remynd text \"$day HH:MM\" \"$day HH:MM\""
}

cmd_apps() {
  local days="${1:-7}" db since
  db="$(remynd_db_path "$(_profile)")"
  since="$(/bin/date -u -v-"${days}"d '+%Y-%m-%d %H:%M:%S')"
  local lo; lo="$(remynd_id_at_time "$db" FocusedWindow startedAt "$since")"
  echo "# Time by app, last $days days"
  echo
  remynd_sql "$db" "
    SELECT applicationName,
           CAST(SUM(MAX(0, strftime('%s', COALESCE(endedAt, startedAt)) - strftime('%s', startedAt))) / 60 AS INT) mins
    FROM FocusedWindow
    WHERE id >= $lo AND applicationName IS NOT NULL AND applicationName != '' AND applicationName NOT IN ('loginwindow','ScreenSaverEngine','Window Server','WindowServer')
    GROUP BY applicationName HAVING mins > 0 ORDER BY mins DESC LIMIT 20;" |
  /usr/bin/awk -F"$REMYND_FS" '
    NF { h = int($2/60); m = $2%60; printf "  %-30s %3dh %02dm\n", $1, h, m }'
}

cmd_text() {
  [ $# -ge 1 ] || die "usage: remynd text <from> [to]      e.g. remynd text \"2026-08-13 23:30\" \"2026-08-13 23:45\""
  local from="$1" to="${2:-}" db redact lo hi
  db="$(remynd_db_path "$(_profile)")"
  redact="$(remynd_config_get redact_credentials 1)"
  case "$from" in *:*:*) ;; *:*) from="$from:00" ;; *) from="$from 00:00:00" ;; esac
  from="$(remynd_local_to_utc "$from")" || die "bad time: $1"
  lo="$(remynd_id_at_time "$db" OCRTextSegment firstSeenAt "$from")"
  if [ -n "$to" ]; then
    case "$to" in *:*:*) ;; *:*) to="$to:00" ;; *) to="$to 00:00:00" ;; esac
    to="$(remynd_local_to_utc "$to")" || die "bad time: $2"
    hi="$(remynd_id_at_time "$db" OCRTextSegment firstSeenAt "$to")"
  else
    hi="$(remynd_max_ocr_id "$db")"; hi=$(( hi + 1 ))
  fi

  remynd_sql "$db" "
    SELECT datetime(firstSeenAt,'localtime'), REPLACE(REPLACE(displayText, char(10), ' '), char(13), ' '), normalizedText
    FROM OCRTextSegment WHERE id >= $lo AND id < $hi ORDER BY id ASC;" |
  /usr/bin/awk -F"$REMYND_FS" -v doredact="$redact" '
'"$(_remynd_redact_awk)"'
    { k = $3; if (k == "") k = $2
      if (k in seen) next
      seen[k] = 1
      t = $2; if (t == "") next
      if (doredact == 1) t = redact(t)
      if (t in shown) next
      shown[t] = 1
      printf "%s  %s\n", substr($1, 12, 8), t }
    END { if (NR == 0) print "(nothing recorded in that range)" }'
}

cmd_status() {
  local p db state
  if ! p="$(remynd_find_profile 2>/dev/null)"; then
    echo "ReMynd:      not found"
    echo "Sync:        inactive (nothing to read yet)"
    return 0
  fi
  db="$(remynd_db_path "$p")"
  state="$(remynd_state_dir)"

  local mtime now age last
  mtime="$(remynd_db_mtime "$db")"
  now="$(/bin/date +%s)"
  age=$(( now - mtime ))
  last="$(remynd_sql "$db" "SELECT datetime(firstSeenAt,'localtime') FROM OCRTextSegment ORDER BY id DESC LIMIT 1;")"

  echo "Profile:     $p"
  case "$(basename "$p")" in
    *-dev-*|*-dev) echo "Build:       DEVELOPMENT (production is preferred when both exist)" ;;
    *)             echo "Build:       production" ;;
  esac
  echo "Database:    $(/usr/bin/du -h "$db" 2>/dev/null | /usr/bin/awk '{print $1}')"
  echo "Last write:  $(_ago "$age") ago"
  [ -n "$last" ] && echo "Last capture: $last (local time)"
  echo "Redaction:   $([ "$(remynd_config_get redact_credentials 1)" = "1" ] && echo "on (credential-shaped strings)" || echo "OFF")"
  echo "Enabled:     $([ "$(remynd_config_get enabled 1)" = "1" ] && echo yes || echo no)"
  if [ -f "$state/context.md" ]; then
    echo "Cache:       $(remynd_tokens_of_file "$state/context.md") tokens, refreshed $(_ago $(( now - $(stat -f %m "$state/context.md") ))) ago"
  else
    echo "Cache:       not built yet (run: remynd refresh)"
  fi
}

_ago() {
  local s="$1"
  if   [ "$s" -lt 90 ]    ; then echo "${s}s"
  elif [ "$s" -lt 5400 ]  ; then echo "$(( s / 60 ))m"
  elif [ "$s" -lt 172800 ]; then echo "$(( s / 3600 ))h"
  else                           echo "$(( s / 86400 ))d"; fi
}

# ---------------------------------------------------------------------------
# Machine-readable output, for callers that need fields rather than a report.
#
# `search` and `fetch` in the MCP server build ChatGPT's connector contract out
# of these — that contract wants an id, a title and a url per result, and
# parsing those back out of the human-facing report would be guesswork. So the
# CLI grew one command that emits them directly.
#
# A "moment" is one focused window, not one OCR line. A search for a word that
# was on screen for ten minutes matches hundreds of segments inside the same
# window; returning those as hundreds of results is noise. Collapsing them to
# the window gives one result per thing-the-user-was-actually-looking-at.
# ---------------------------------------------------------------------------
cmd_moments() {
  [ $# -ge 1 ] || die "usage: remynd moments <query> [limit]"
  local q="$1" limit="${2:-20}" db redact esc
  db="$(remynd_db_path "$(_profile)")"
  redact="$(remynd_config_get redact_credentials 1)"
  esc="$(printf '%s' "$q" | /usr/bin/sed "s/'/''/g")"

  # Over-fetch segments so that after collapsing to windows there are still
  # `limit` distinct moments to return.
  local scan=$(( limit * 12 ))

  remynd_sql "$db" "
    WITH hits AS (
      SELECT s.firstSeenAt AS ts, s.displayText AS txt
      FROM OCRTextSegment s
      JOIN OCRTextSegment_FTS f ON f.rowid = s.id
      WHERE OCRTextSegment_FTS MATCH '$esc'
      ORDER BY s.firstSeenAt DESC
      LIMIT $scan
    ),
    -- ORDER BY x.id, not x.startedAt. There is no index on startedAt, so
    -- ordering by it full-scans 187k FocusedWindow rows for EVERY hit: 8.5s
    -- for twenty results. startedAt rises with the rowid, so walking the rowid
    -- index backwards and stopping at the first match finds the same row in
    -- 47ms — verified identical on a 40-row sample, 0 disagreements.
    tagged AS (
      SELECT h.ts, h.txt,
             (SELECT x.id FROM FocusedWindow x
               WHERE x.startedAt <= h.ts
               ORDER BY x.id DESC LIMIT 1) AS wid
      FROM hits h
    )
    SELECT COALESCE(t.wid, 0),
           datetime(t.ts,'localtime'),
           COALESCE(w.applicationName,''),
           COALESCE(w.windowTitle,''),
           REPLACE(REPLACE(REPLACE(t.txt, char(10), ' '), char(9), ' '), char(13), ' ')
    FROM tagged t LEFT JOIN FocusedWindow w ON w.id = t.wid
    ORDER BY t.ts DESC;" |
  /usr/bin/awk -F"$REMYND_FS" -v doredact="$redact" -v lim="$limit" '
'"$(_remynd_redact_awk)"'
    NF >= 5 {
      # One row per focused window: the first row for a window is its most
      # recent hit, which is the one worth showing.
      if ($1 != 0 && seen[$1]++) next
      if (n++ >= lim) exit
      t = $5; if (doredact == 1) t = redact(t)
      printf "%s\t%s\t%s\t%s\n", $2, $3, $4, t
    }'
}

# One moment, expanded: which app and window it was, then the text that was on
# screen around it. `fetch` in the MCP server is exactly this call — ChatGPT
# hands back an id from `moments` and expects the document behind it.
cmd_moment() {
  [ $# -ge 1 ] || die "usage: remynd moment <YYYY-MM-DD HH:MM:SS> [minutes]"
  local ts="$1" span="${2:-4}" db ts_utc
  db="$(remynd_db_path "$(_profile)")"
  ts_utc="$(remynd_local_to_utc "$ts")" || die "bad timestamp: $ts"

  # The window that was focused at that instant. Same rowid-ordering trick as
  # cmd_moments, for the same reason.
  remynd_sql "$db" "
    SELECT COALESCE(applicationName,''), COALESCE(windowTitle,'')
    FROM FocusedWindow
    WHERE startedAt <= '$ts_utc'
    ORDER BY id DESC LIMIT 1;" |
  /usr/bin/awk -F"$REMYND_FS" 'NR==1 { printf "%s\t%s\n", $1, $2 } END { if (NR==0) print "\t" }'
  echo

  local from to
  from="$(/bin/date -j -v-"${span}"M -f '%Y-%m-%d %H:%M:%S' "$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" \
    || die "bad timestamp: $ts"
  to="$(/bin/date -j -v+"${span}"M -f '%Y-%m-%d %H:%M:%S' "$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
  cmd_text "$from" "$to"
}

cmd_refresh() { "$_here/remynd-refresh.sh" --force && cmd_status; }

case "${1:-}" in
  now)     shift; cmd_now "$@" ;;
  recent)  shift; cmd_recent "$@" ;;
  search)  shift; cmd_search "$@" ;;
  moments) shift; cmd_moments "$@" ;;
  moment)  shift; cmd_moment "$@" ;;
  day)     shift; cmd_day "$@" ;;
  apps)    shift; cmd_apps "$@" ;;
  text)    shift; cmd_text "$@" ;;
  status)  shift; cmd_status "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: remynd help)" ;;
esac
